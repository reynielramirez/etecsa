<?php

/**
 * @file
 * Define the hook example related to email attachment.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\email_attachment_demo\Hook\EmailAttachmentDemoHooks;

/**
 * Implements hook_mail_alter().
 *
 * This is an example implementation to show how to alter emails generated by
 * other modules. Go to the URL /contact to send an email. It will arrive with
 * this file attached.
 */
#[LegacyHook]
function email_attachment_demo_mail_alter(&$message) {
  \Drupal::service(EmailAttachmentDemoHooks::class)->mailAlter($message);
}
