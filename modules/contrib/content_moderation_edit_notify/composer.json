{
  "name": "drupal/content_moderation_edit_notify.info",
  "description": "Notify users if a new revision is saved when editing a moderated node.",
  "type": "drupal-module",
  "homepage": "https://drupal.org/project/content_moderation_edit_notify",
  "authors": [
      {
          "name": "Jean Valverde (mogtofu33)",
          "email": "contact@developpeur-drupal.com",
          "homepage": "https://developpeur-drupal.com",
          "role": "Maintainer"
      }
  ],
  "support": {
      "issues": "https://www.drupal.org/project/issues/content_moderation_edit_notify",
      "source": "https://git.drupalcode.org/project/content_moderation_edit_notify"
  },
  "license": "GPL-2.0-or-later",
  "minimum-stability": "dev",
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  },
  "require-dev": {
    "edgedesign/phpqa": "^1.26",
    "drupal/coder": "dev-8.x-3.x",
    "dealerdirect/phpcodesniffer-composer-installer": "dev-master",
    "mglaman/phpstan-drupal": "^1.1",
    "phpstan/phpstan-deprecation-rules": "^1",
    "phpstan/extension-installer": "^1.1",
    "php-parallel-lint/php-parallel-lint": "dev-develop",
    "nette/neon": "4.0.x-dev"
  }
}
