{% apply spaceless %}
    <div class="container page-content bg-white" >
        <div class="row">
            <div class="ml-4">
                <div class="page-title azuloscuro">
                    <h2>{{ 'About us'|t|upper }}</h2>
                </div>
            </div>    
            <div class="cmt">
                {% if data.0.get('field_imagenn')|length > 0 %}
                    <img class="w-100 mb-3" src="{{ file_url(data.0.get('field_imagenn').entity.uri.value)}}">
                {% endif %}
            </div>      
            {% if data.0.get('field_imagenn')|length > 0 %}
                <div class="sep col-lg-5 col-md-4 ml-5 d-lg-block d-md-block d-none"></div>        
                <div class="offset-lg-7 offset-md-6  select-enlacetopic pb-3">             
                    {{ drupal_block('etecsa_menusn_block', wrapper=false) }}                
                </div>
		    {% else %}
                <div class="offset-lg-4 offset-md-3  select-enlacetopic">
                    {{ drupal_block('etecsa_menusn_block', wrapper=false) }}
                </div>
		    {% endif %}	
        </div>    
            
            {% if data|length > 0 %}    
            <div class="col-12 pt-2 pl-5 pr-5">
                <h3 class="title-tono">{{data.0.get('title').value}}</h3>
                <div class="word-break">{{data.0.get('field_descripcion_espacios').value|raw }}</div>                
            </div>  
            {% endif %}          
        </div>       
         <!--<div class="row filtro-rt py-3 pl-5 pr-5 mr-5 ml-5">  
            <div class="col-8 pt-2">
                <p>{{"Articles will be grouped by annual editions and within each edition there will be different articles which address various topics related to communications technologies"|t}}</p>
            </div>        
        </div>!-->
    </div>
    <div class="rt mb-5">
           {{drupal_view('revista_tono', 'block_1')}}      
        </div>  
    
{% endapply %}
  
