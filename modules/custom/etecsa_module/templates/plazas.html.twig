{% apply spaceless %}
	<div class="container rc-content bg-white">
		<div class="row ">
			<div class="ml-4">
				<div class="page-title azuloscuro">
					<h2>{{'Places in calls'|t|upper}}</h2>
				</div>
			</div>
			{% set content_general = plazas.general %}
			{% if content_general.field_tipo_imagen.value == 'grande' and content_general.field_imagen_grande.entity.uri.value|length > 0 %}
				{% set img = file_url(content_general.field_imagen_grande.entity.uri.value) %}
			{% elseif content_general.field_tipo_imagen.value == 'pequeña' and content_general.field_imagen_pequena.entity.uri.value|length > 0 %}  
				{% set img = file_url(content_general.field_imagen_pequena.entity.uri.value) %}
			{% endif %} 
		
			{% if img %}
			<div class="cmt">
				<img  class="w-100" src="{{ img }}" alt="">
			</div>   
			<div class="sep col-lg-5 col-md-4 ml-5 d-lg-block d-md-block d-none"></div>        
			<div class="offset-lg-7 offset-md-6  select-enlacetopic pb-3">
			  {{ drupal_block('etecsa_menusn_block', wrapper=false) }}
			</div>
		{% else %}
			<div class="offset-lg-7 offset-md-6  select-enlacetopic">
			  {{ drupal_block('etecsa_menusn_block', wrapper=false) }}
			</div>	
		{% endif %}
		</div>

		<div class="row rc-content-data px-2 pl-lg-5 pr-lg-5 justify-content-center">
			<div class="col-12 rcdescrpcion word-break pb-3">
				{{ content_general.field_descripcion_espacios.value|raw }}
			</div>
			<div class="col-12 select-provmun mb-3">
				{{form}}
			</div>
            {% if plazas.plazas|length > 0 %}
                {% set plazas = plazas.plazas %}
                {% for p in plazas %}
                    <div class="col-md-4 col-xs-12 container-plaza">
                        <div class="item-plaza">
                            <h4 class="title-page title-plaza">
                                {{ p.get('title').value }}
                            </h4>
                            <div class="resumen">
                                {{ p.get('field_resumen_largo').value|raw }}
                            </div>
							<div style="text-align: center; padding: 25px 10px 10px;">
                            <div class="btn-more-plaza button--aylen">
                                <a href="{{ path('entity.node.canonical', {'node': p.nid.value }) }}">
								{{ 'More information'|t|upper }}</a>
                            </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <p class="pl-5 py-4">{{"There are not items to display"|t}}</p>
            {% endif %}
			</div>
		</div>
	</div>
{% endapply %}
