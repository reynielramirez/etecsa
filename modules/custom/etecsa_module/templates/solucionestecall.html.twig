{% set nacionales = data.nacional %}
{% set internacionales = data.internacional %}
{% apply spaceless %}
  {% if nacionales|length>0 or internacionales|length>0 %}
    <div class="container bg-white pb-5">
      <div class="row">
        <div class="ml-1 ml-lg-4">
          <div class="page-title nodeso azulclaro mb-2">
            <h2>{{'Technological Solutions'|t|upper}}</h2>
          </div>
        </div>
        <div class="offset-lg-2 pl-3 select-servoportunidadAll pt-3">
          <label>{{"Seleccionar:"|t}}</label>					
          <select name="servoportunidad" id="edit-servoportunidad">
            {% if nacionales|length >0 and internacionales|length >0 %}
              <option value="todos">{{"All"|t}}</option>
            {% endif %}
            {% if nacionales|length >0  %}
              <option value="nacionales">{{"National"|t}}</option>
            {% endif %}	
            {% if internacionales|length >0 %}
              <option value="internacionales">{{"International"|t}}</option>
            {% endif %}
          </select>
        </div>
      </div>
      {% if internacionales|length >0 %}
        <div class="items oportunidad internacionales">
          <div class="title pl-3">						
            <h4>{{'International'|t|upper}}</h4>
          </div>						
          <div class="d-xs-block d-sm-block d-md-none d-lg-none">
            <div id="carousel-oport" class="owl-carousel owl-carousel-servoport owl-theme">
              {% for content in internacionales %}
                <div class="col-md-4 mb-3 ccol">
				          {% set btn_text = null %}
                  {% if content.field_clasif_enlace_descrip.value == 'ninguno' %}  
                    {% set link = ""  %}
                  {% elseif content.field_clasif_enlace_descrip.value == 'descripcion' and content.field_descripcion.value|length > 0 %}
                    {% set link = "href="~path('entity.node.canonical', {'node': content.get('nid').value }) %}
                    {% set btn_text = content.get('field_texto_boton').value %}
                  {% elseif content.field_clasif_enlace_descrip.value == 'enlace' and content.field_enlace.value|length > 0 %}  
                    {% set link = "href="~content.field_enlace.uri %}
					          {% set btn_text = content.get('field_texto_boton').value %}
                  {% endif %} 
                  <a {{ link }}>
                    <div class="servoport-item">
                      <div class="servoport-img-item">
                        <img class="col-md-12" src="{{ file_url(content.get('field_image').entity.uri.value) }}" alt="{{ content.get('field_image').alt}}"/>
                      </div>
                      <div class="servoport-text">
                        <h2 class="servoport-title todas">{{ content.get('title').value }}</h2>
                      </div>
                      <div class="sombra pb-4">
                        <h3 class="servoport-subtitle">{{ content.get('field_subtitulo').value }}</h3>
                        <div class="servoport-resumen mt-2 pl-4 pr-4 word-break">{{ content.get('field_resumen_largo').value|raw  }}</div>
                        {% if btn_text %}
                          <div class="btn-inside-content button--aylen">
                            <a {{ link }} >
                              {{ btn_text }}
                            </a>
                          </div>
                        {% endif %}
                      </div>
                    </div>
                  </a>
                </div>
              {% endfor %}
            </div>
          </div>
          <div class="d-none d-xs-none d-sm-none d-md-block d-lg-block">
            <div class="row no-gutters px-3 text-center justify-content-center">
              {% for content in internacionales %}
                <div class="col-4 mb-3">
				          {% set btn_text = null %}
                  {% if content.field_clasif_enlace_descrip.value == 'ninguno' %}  
                    {% set link = ""  %}
                  {% elseif content.field_clasif_enlace_descrip.value == 'descripcion' and content.field_descripcion.value|length > 0 %}
                    {% set link = "href="~path('entity.node.canonical', {'node': content.get('nid').value }) %}
                    {% set btn_text = content.get('field_texto_boton').value %}
                  {% elseif content.field_clasif_enlace_descrip.value == 'enlace' and content.field_enlace.value|length > 0 %}  
                    {% set link = "href="~content.field_enlace.uri %}
					          {% set btn_text = content.get('field_texto_boton').value %}
                  {% endif %} 
                  <a {{ link }}>
                    <div class="servoport-item">
                      <div class="servoport-img-item">
                        <img src="{{ file_url(content.get('field_image').entity.uri.value) }}" alt="{{ content.get('field_image').alt }}"/>
                      </div>
                      <div class="servoport-text">
                        <h2 class="servoport-title">{{ content.get('title').value }}</h2>
                      </div>  
                      <div class="sombra pb-4">
                          <h3 class="servoport-subtitle">{{ content.get('field_subtitulo').value }}</h3>
                          <div class="servoport-resumen  pl-4 pr-4 word-break">{{ content.get('field_resumen_largo').value|raw  }}</div>
                          {% if btn_text %}
                            <div class="btn-inside-content button--aylen">
                              <a {{ link }} >
                                {{ btn_text }}
                              </a>
                            </div>
                          {% endif %}
                      </div> 
                    </div>
                  </a>
                </div>
              {% endfor %}
            </div>
          </div>					
        </div>
      {% endif %}				
      {% if nacionales|length >0 and internacionales|length >0  %}
        <div class="items col-12 todos mb-4">
          <div class="sep my-2" style="margin-bottom: 3rem!important;"></div>
        </div>
      {% endif %}
      {% if nacionales|length >0  %}
        <div class="items oportunidad nacionales">
          <div class="title pl-3 ">						
            <h4>{{'National'|t|upper}}</h4>
          </div>						
          <div class="d-xs-block d-sm-block d-md-none d-lg-none">
            <div id="carousel-oport" class="owl-carousel owl-carousel-servoport owl-theme">
              {% for content in nacionales %}
                <h2>{{ content.get('title').value }}</h2>
                <div class="col-md-4 mb-3 ccol">
				          {% set btn_text = null %}
                  {% if content.field_clasif_enlace_descrip.value == 'ninguno' %}  
                    {% set link = ""  %}
                  {% elseif content.field_clasif_enlace_descrip.value == 'descripcion' and content.field_descripcion.value|length > 0 %}
                    {% set link = "href="~path('entity.node.canonical', {'node': content.get('nid').value }) %}
                    {% set btn_text = content.get('field_texto_boton').value %}
                  {% elseif content.field_clasif_enlace_descrip.value == 'enlace' and content.field_enlace.value|length > 0 %}  
                    {% set link = "href="~content.field_enlace.uri %}
					          {% set btn_text = content.get('field_texto_boton').value %}
                  {% endif %} 
                  <a {{ link }}>
                    <div class="servoport-item">
                      <div class="servoport-img-item">
                        <img class="col-md-12" src="{{ file_url(content.get('field_image').entity.uri.value) }}" alt="{{ content.get('field_image').alt}}"/>
                      </div>
                      <div class="servoport-text">
                        <h2 class="servoport-title todas">{{ content.get('title').value}}</h2>
                      </div>
                      <div class="sombra pb-4">
                        <h3 class="servoport-subtitle">{{ content.get('field_subtitulo').value}}</h3>
                        <div class="servoport-resumen mt-2 pl-4 pr-4 word-break">{{ content.get('field_resumen_largo').value|raw  }}</div>
                        {% if btn_text %}
                          <div class="btn-inside-content button--aylen">
                            <a {{ link }} >
                              {{ btn_text }}
                            </a>
                          </div>
                        {% endif %}
                      </div>
                    </div>
                  </a>
                </div>
              {% endfor %}
            </div>
          </div>
          <div class="d-none d-xs-none d-sm-none d-md-block d-lg-block">
            <div class="row no-gutters px-3 text-center justify-content-center">
              {% for content in nacionales %}
                <div class="col-4 mb-3">
				          {% set btn_text = null %}
                  {% if content.field_clasif_enlace_descrip.value == 'ninguno' %}  
                    {% set link = ""  %}
                  {% elseif content.field_clasif_enlace_descrip.value == 'descripcion' and content.field_descripcion.value|length > 0 %}
                    {% set link = "href="~path('entity.node.canonical', {'node': content.get('nid').value }) %}
                    {% set btn_text = content.get('field_texto_boton').value %}
                  {% elseif content.field_clasif_enlace_descrip.value == 'enlace' and content.field_enlace.value|length > 0 %}  
                    {% set link = "href="~content.field_enlace.uri %}
					          {% set btn_text = content.get('field_texto_boton').value %}
                  {% endif %} 
                  <a {{ link }}>
                    <div class="servoport-item">
                      <div class="servoport-img-item">
                        <img src="{{ file_url(content.get('field_image').entity.uri.value) }}" alt="{{ content.get('field_image').alt }}"/>
                      </div>
                      <div class="servoport-text">
                        <h2 class="servoport-title">{{ content.get('title').value }}</h2>
                      </div>  
                      <div class="sombra pb-4">
                          <h3 class="servoport-subtitle">{{ content.get('field_subtitulo').value }}</h3>
                          <div class="servoport-resumen  pl-4 pr-4 word-break">{{ content.get('field_resumen_largo').value|raw  }}</div>
                          {% if btn_text %}
                            <div class="btn-inside-content button--aylen">
                              <a {{ link }} >
                                {{ btn_text }}
                              </a>
                            </div>
                          {% endif %}
                      </div> 
                    </div>
                  </a>
                </div>
              {% endfor %}
            </div>
          </div>					
        </div>
      {% endif %}
    </div>
	{% endif %}

{% endapply %}
   


              
