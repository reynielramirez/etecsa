{% apply spaceless %}

	<div class="container bg-white">
		<div class="row">
			<div class="ml-4">
				<div class="page-title azuloscuro">
					<h2>{{'INTERNET NAVIGATION'|t|upper}}</h2>
				</div>
			</div>
			
		  {% set content = descripcion.0 %}
		  {% if content.field_tipo_imagen.value == 'grande' and content.field_imagen_grande.value|length > 0 %}
			{% set img = file_url(content.field_imagen_grande.entity.uri.value) %}
		  {% elseif content.field_tipo_imagen.value == 'pequeña' and content.field_imagen_pequena.value|length > 0 %}  
			{% set img = file_url(content.field_imagen_pequena.entity.uri.value) %}
		  {% endif %} 
		
		  {% if img %}
			<div class="cmt">
				<img  class="w-100" src="{{ img }}" alt="">
			</div>   
		  {% endif %} 
			
			<div class="description">
				<h4 class="title  mt-3">{{'Navigation rooms and public spaces (WIFI)'|t}}</h4>
				<div class="word-break">{{ descripcion.0.get('field_descripcion_espacios').value|raw }}</div>

				<div class=" select-salasespacios mb-5 mt-3 py-3">
					{{form}}
				</div>
			</div>

		{% if data %}
			<div class="description">
				<div class="salas-espacios pb-5  mb-5">
						<div id="accordionExample" class="accordion">
							{% set num = 0 %}
							{% set count = 1 %}
							{% set expanded = "false"%}
							{% set show = ""%}
							{% for keys, items in data %}
								{% if loop.first %}
									{% set expanded = "true"%}
									{% set show = "show"%}
								{% endif %}
								<div class="card{{num}} mt-3 mb-3">
									<div id="heading{{ num }}" class="card-header bg-white {{show}} py-2" data-toggle="collapse" data-target="#collapse{{ num }}" aria-expanded="{{expanded}}" aria-controls="collapse{{ num }}">
										<div class="position-relative collapsible-link word-break">
											<h5 class="titleProv ml-4">{{keys}}</h5>
										</div>
									</div>
									<div id="collapse{{ num }}" aria-labelledby="heading{{ num }}" data-parent="#accordionExample" class="collapse {{show}} ">
										<div class="card-body p-3 p-md-4 p-lg-4">
											{% if items.salas|length >0 %}
												<div class="title pl-4">
													<h4>{{'Navigation rooms'|t}}
														<span class="float-right snum">{{items.salas|length}}</span>
													</h4>
												</div>
												<div class="row my-4">
													{% for key,item in items.salas %}
														<div class="item col-12 pt-3">
															<div class="col-1 icono">
																{% if item.icono %}
																	<img src="{{ file_url(item.icono) }}" class="img-responsive">
																{% endif %}
															</div>
															<div class="col-6 pl-0">
																<h5 class="azulclaro-salas">{{item.nombre}}</h5>
																<p>{{item.direccion}}</p>
															</div>
															<div class="col-4  offset-1">
																{% if item.posiciones %}
																	<p class="azulclaro-salas">
																		<bold>
																			{{item.posiciones}}
																		</bold>
																		{{'positions'|t}}
																	</p>
																{% endif %}
																{% if  item.horario %}
																	<p>{{item.horario}}</p>
																{% endif %}
															</div>
														</div>
														{% if not loop.last %}
															<div class="cborderEsp"></div>
														{% endif %}
													{% endfor %}

												</div>
											{% endif %}
											{% if items.espacios|length >0 %}
												<div class="title pl-4">
													<h4>{{'Hotspots (WIFI)'|t}}
														<span class="float-right snum">{{items.cantidad}}</span>
													</h4>
												</div>
												<div class="row my-4">
													{% for key, item in items.espacios %}
														<div class="col-12">
															<h5 class="azulclaro-salas mt-2 ml-3">{{key}}</h5>
															<div class="row">
																{% set cant = item|length // 2 %}
																{% if item|length is odd  %}
																	{% set cant =cant+1 %}																	
																{% endif %}
																{% set countS = 1 %}
																{% for  value in item %}													
																	{% if countS == 1  %}
																		<div class="col-6">																	
																	{% endif %}                              
																		<p class="mb-0 ml-4">{{value.nombre}}</p>
																	{% if countS == cant or cant == 0  %}
																		</div>
																		{% set countS = 1 %}
																		{% set cant = item|length - cant %}
																	{% else %}
																		{% set countS = countS + 1 %}
																	{% endif %}
																{% endfor %}																
															</div>
														</div>
														{% if not loop.last %}
															<div class="cborderEsp pb-2"></div>
														{% endif %}	
													{% endfor %}
												</div>
											{% endif %}
										</div>
									</div>
									{% set num = num+1 %}
								</div>
							{% endfor %}
							
						</div>
				</div>
		</div>		
		{% else %}
			<p class="pl-5 py-4">{{"There are not items to display"|t}}</p>
		{% endif %}
		</div>
	</div>

{% endapply %}
