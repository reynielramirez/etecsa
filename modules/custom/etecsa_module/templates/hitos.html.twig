{% apply spaceless %}
	<div class="container rc-content bg-white">
		<div class="row ">
			<div class="ml-4">
				<div class="page-title azuloscuro">
					<h2>{{'Milestones in History'|t|upper}}</h2>
				</div>
			</div>
			{% set content = hitos.general.0 %}
	    {% if content.field_tipo_imagen.value == 'grande' and content.field_imagen_grande.entity.uri.value|length > 0 %}
		  {% set img = file_url(content.field_imagen_grande.entity.uri.value) %}
	    {% elseif content.field_tipo_imagen.value == 'pequeña' and content.field_imagen_pequena.entity.uri.value|length > 0 %}  
		  {% set img = file_url(content.field_imagen_pequena.entity.uri.value) %}
	    {% endif %} 
		
			{% if img %}
			<div class="cmt">
				<img  class="w-100" src="{{ img }}" alt="">
			</div>   
			<div class="sep col-lg-5 col-md-4 ml-5 d-lg-block d-md-block d-none"></div>        
			<div class="offset-lg-7 offset-md-6  select-enlacetopic pb-3">
			  {{ drupal_block('etecsa_menusn_block', wrapper=false) }}
			</div>
		{% else %}
			<div class="offset-lg-7 offset-md-6  select-enlacetopic">
			  {{ drupal_block('etecsa_menusn_block', wrapper=false) }}
			</div>	
		{% endif %}
		</div>

		<div class="row rc-content-data px-2 pl-lg-5 pr-lg-5 py-3">
			<div class="col-12 rcdescrpcion word-break pb-3">
				{{ content.field_descripcion_espacios.value|raw }}
			</div>
		</div>
		{% if hitos.hitos|length > 0 %}
			<div class="col padd-custom d-none d-xs-none d-sm-none d-md-block d-lg-block"><hr></div>
			<div class="row rc-content-data hitos px-2 pl-lg-5 pr-lg-5 bord-bottom
												justify-content-around align-content-around">
				{% set hitos = hitos.hitos %}
				<div class="col-5 mt-lg-3 d-none d-xs-none d-sm-none
																				d-md-block d-lg-block">
					<div class="row">
						{% for h in hitos %}
							{% if loop.index is not divisible by(2) %}
								<div class="col-12 container-hito izq">
									<div class="item-hito">
										<h4 class="title-page title-hito">
											{{ h.get('title').value }}
										</h4>
										<div class="resumen">
											{{ h.get('body').value|raw }}
										</div>
									</div>
								</div>
							{% endif %}
						{% endfor %}
					</div>
				</div>
				<div class="col-1 d-none d-xs-none d-sm-none
																				d-md-block d-lg-block">
					<hr class="v-line"></hr>
				</div>
				<div class="col-5 mt-lg-5 d-none d-xs-none d-sm-none
																		d-md-block d-lg-block">
					<div class="row">
						{% for h in hitos %}
							{% if loop.index is divisible by(2) %}
								<div class="col-12 container-hito der">
									<div class="item-hito">
										<h4 class="title-page title-hito">
											{{ h.get('title').value }}
										</h4>
										<div class="resumen">
											{{ h.get('body').value|raw }}
										</div>
									</div>
								</div>
							{% endif %}
						{% endfor %}
					</div>
				</div>
			</div>

			{# vista movil #}
			<div class="row ">
			
			<div class="col-11 pl-0 d-block d-xs-block d-sm-block d-md-none d-lg-none">
				{% for h in hitos %}
						<div class="col my-3 izq-m">
							<div class="item-hito">
								<h4 class="title-page title-hito">
									{{ h.get('title').value }}
								</h4>
								<div class="resumen">
									{{ h.get('body').value|raw }}
								</div>
							</div>
						</div>
					{% endfor %}
			</div>
			<div class="col-1 px-0 d-block d-xs-block d-sm-block d-md-none d-lg-none">
				<hr class="v-line"></hr>
			</div>
			</div>

		{% else %}
		<div class="row rc-content-data">
			<p class="pl-5 py-4">{{"There are not items to display"|t}}</p>
		</div>
	{% endif %}
</div>{% endapply %}
