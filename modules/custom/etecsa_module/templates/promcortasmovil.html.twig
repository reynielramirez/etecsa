{% apply spaceless %}
<div class="col promc-close d-block-pr d-sm-block-pr d-md-none d-lg-none" style="height: auto; padding: 5px 5px 0;">
<a class="promc-close-b"><i class="fa fa-times"></i></a>
    {% if data %}
        {% for d in data %}
        <div class="row prommovil {% if loop.index != 1 %} pdesactive {% endif %} promcortamovil no-gutters pl-3" >
            <div class="col-8 pt-2 pl-1">
                <p class="promc-title">{{ d.title.value }}</p>
                <p class="promc-summary">{{ d.resumen }}</p>
            </div>
            <div class="col">
                <div class="ebtn3">
                    <div class="azul3">
                        {% if  d.field_enlace.0.url.external %}
                            {% set target="_blank" %}
                        {% else %}
                            {% set target="" %}
                        {% endif %}    
                        <a href="{{ d.field_enlace.0.url }}" target="{{target}}"><span>{{ d.field_enlace.0.title|upper }}</span></a>
                    </div>
                </div>
            </div>
        </div>
    {% endfor %}
    {% endif %}
</div>
{% endapply %}
