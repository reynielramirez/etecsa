<div class="block-compartir">
	<div class="compartir">
		<span class="fa fa-share-alt"></span>
		<div class="redesocN  nodeN">
			<button class="button" data-sharer="facebook" data-title="{{ title }}" data-url="{{host}}/{{language}}{{ url }}">
				<i class="fab fa-facebook-f so2"></i>
			</button>
			<button class="button" data-sharer="twitter" data-title="{{ title }}" data-url="{{host}}/{{language}}{{ url }}">
				<i class="fab fa-twitter so2"></i>
			</button>
			<button class="button" data-sharer="whatsapp" data-title="{{ title }}" data-url="{{host}}/{{language}}{{ url }}">
				<i class="fab fa-whatsapp so2"></i>
			</button>
			<button class="button" data-sharer="telegram" data-title="{{ title }}" data-url="{{host}}/{{language}}{{ url }}" data-web="">
				<i class="fab fa-telegram-plane so2"></i>
			</button>
		</div>
	</div>
</div>
