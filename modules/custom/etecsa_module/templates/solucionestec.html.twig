{% apply spaceless %}
{% if cliente=="empresas" or cliente=="companies" %}
  {% set cpath="etecsa.solucionestecempresa"%}
{% else %}
  {% set cpath="etecsa.solucionestecemp"%}
{% endif %}
  {% if data %}
    <div class="sesion-servicios-oportunidades {{ visibility }}">
      <div class="container mt-3 mb-3">
        <div class="section-heading">
          <h1 class="title-color">{{ 'Technological Solutions'|t|upper }}</h1>
        </div>
        <div class="d-block d-sm-block d-md-none d-lg-none">
        <div id="carousel-servoport" class="owl-carousel owl-carousel-servoport owl-theme">
          {% for res in data %}
            {% set content = res %}
            {% if content.field_clasif_enlace_descrip.value == 'ninguno' %}  
              {% set link = "" %}
            {% elseif content.field_clasif_enlace_descrip.value == 'descripcion' and content.field_descripcion.value|length > 0 %}
              {% set link = "href="~path('entity.node.canonical', {'node': content.get('nid').value }) %}
            {% elseif content.field_clasif_enlace_descrip.value == 'enlace' and content.field_enlace.value|length > 0 %}  
              {% set link = "href="~content.field_enlace.uri %}
            {% endif %}
            <a {{ link }} >
              <div class="servoport-item">
                <div class="servoport-img-item">
                  <img src="{{ file_url(res.get('field_image').entity.uri.value) }}"
                      alt="{{ res.get('field_image').alt }}"/>
                </div>
                <div class="servoport-text">
                  <h2 class="servoport-title">{{ res.get('title').value }}</h2>                  
                </div>
                <div class="sombra pb-4 mb-2">
								  <h3 class="servoport-subtitle">{{ res.get('field_subtitulo').value }}</h3>
                  <div class="servoport-resumen mt-2 pl-4 pr-4 word-break">{{ res.get('field_resumen_corto').value }}</div>
								</div>
              </div>
            </a>
          {% endfor %}
        </div>
        </div>

        <div class="d-none d-sm-none d-md-block d-lg-block">
        <div class="row text-center justify-content-center">
        {% for res in data %}
          <div class="col-4">   
            {% set content = res %}
            {% if content.field_clasif_enlace_descrip.value == 'ninguno' %}  
              {% set link = "" %}
            {% elseif content.field_clasif_enlace_descrip.value == 'descripcion' and content.field_descripcion.value|length > 0 %}
              {% set link = "href="~path('entity.node.canonical', {'node': content.get('nid').value }) %}
            {% elseif content.field_clasif_enlace_descrip.value == 'enlace' and content.field_enlace.value|length > 0 %}  
              {% set link = "href="~content.field_enlace.uri %}
            {% endif %}
            <a {{ link }} >
              <div class="servoport-item">
                <div class="servoport-img-item">
                  <img src="{{ file_url(res.get('field_image').entity.uri.value) }}"
                      alt="{{ res.get('field_image').alt }}"/>
                </div>
                <div class="servoport-text">
                  <h2 class="servoport-title">{{ res.get('title').value }}</h2>
                </div>
                <div class="sombra pb-4">  
                  <h3 class="servoport-subtitle">{{ res.get('field_subtitulo').value }}</h3>
                  <div class="servoport-resumen  pl-4 pr-4 word-break">{{ res.get('field_resumen_corto').value }}</div>
                </div>
              </div>
            </a>
          </div>
        {% endfor %}
        </div>
        </div>
        <div class="text-align-center cmb">
          <a class="moreOport-link" href="{{ path(cpath) }}">{{ 'More Solutions'|t|upper }}
            <i class="flaticon-next-1 more"></i></a>
        </div>
      </div>
    </div>
  {% endif %}
{% endapply %}
