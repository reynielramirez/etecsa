{% apply spaceless %}
{% if cliente=="people" or cliente=="personas" %}
	{% set cpath = path("etecsa.paquete")%}
{% else %}
	{% set cpath = path("etecsa.paquetemp")%}
{% endif %}
	{% if data|length > 0 %}
		<div class="container {{ visibility }}">
			<div class="row justify-content-center">
				<div class="col-md-12 text-center">
					<h1 class="block-title-custom">{{ 'Mobile Services'|t|upper }}</h1>
					<p class="block-subtitle-custom">{{ 'Active your plans and connect with your people'|t }}</p>
				</div>

				<div class="sesion-internet-movil col-12 col-sm-12 col-md-10 col-lg-10">
					<ul class="nav nav-tabs internet-movil" id="myTab" role="tablist">
						{% set cont = 1%}
						{% for item in pqtes %}
							{% if loop.first %}
								{% set active = "active"%}
							{% else %}
								{% set active = ""%}
							{% endif %}
							<li class="nav-item">
								<a class="nav-link {{active}}" data-toggle="tab" href="#tabim{{cont}}" role="tabpanel">{{item}}</a>
							</li>
							{% set cont = cont+1 %}
						{% endfor %}
						<li class="nav-item">
							<a class="nav-link" id="todos-tab" href="{{ cpath }}">{{ 'all'|t|upper }}</a>
						</li>
					</ul>
					<div class="tab-content" id="myTabContent">
						{% set cont = 1%}
						{% for keys,item in data %}
							{% if loop.first %}
								{% set active = "active"%}
							{% else %}
								{% set active = ""%}
							{% endif %}
							<div class="tab-pane fade show {{active}}" id="tabim{{cont}}" role="tabpanel">
								<div id="carousel-hw-{{cont}}" class="owl-carousel owl-carousel-hw mt-5">
									{% for pqte in item %}
										<div class="element position-relative">
											<div>
												<img src="{{ file_url(pqte.svg) }}">
												{% if pqte.enlace|length > 0 %}
													<div class="btn-purchase button--aylen">
														<a target="_blank" href="{{pqte.enlace|replace({'internal:':''})}}">{{pqte.enlaceText}}</a>
														{# <button class="button button--aylen button--border-thin button--round-s">Previous Song</button> #}
													</div>
												{% endif %}
											</div>
										</div>
									{% endfor %}
								</div>
							</div>
							{% set cont = cont+1 %}
						{% endfor %}
					</div>
				</div>
			</div>
		</div>
	{% endif %}
{% endapply %}
