{% apply spaceless %}
	{% if cliente=="empresas" or  cliente=="companies" %}
		{% set cpath="etecsa.hospweballempresa"%}
	{% else %}
		{% set cpath="etecsa.hospweballemprendedor"%}
	{% endif %}
	{% if data|length > 0 %}
		<div class="container {{ visibility }}">
			<div class="row justify-content-center">
				<div class="col-md-12 text-center">
					<h1 class="block-title-custom">{{ 'Web Hosting'|t|upper }}</h1>
					<p class="block-subtitle-custom">{{ 'Check the offers we have available'|t }}</p>
				</div>

				<div class="hospedajeweb col-12 col-sm-12 col-md-10 col-lg-10">
					<ul class="nav nav-tabs hospweb" id="myTab" role="tablist">
						{% set cont = 1%} 
						{% for item in so %}
							{% if loop.first %}
								{% set active = "active"%}
							{% else %}
								{% set active = ""%}
							{% endif %}
							<li class="nav-item">
								<a class="nav-link {{active}}" data-toggle="tab" href="#tabpa{{cont}}" role="tabpanel">{{item}}</a>
							</li>
							{% set cont = cont+1%}
						{% endfor %}
						<li class="nav-item">
							<a class="nav-link" id="todos-tab" href="{{ path(cpath) }}">{{ 'all'|t|upper }}</a>
						</li>
					</ul>
					<div class="tab-content" id="myTabContent">
						{% set cont = 1%} 
						{% for keys,item in data %}
							{% if loop.first %}
								{% set active = "active"%}
							{% else %}
								{% set active = ""%}
							{% endif %}
                            <div class="tab-pane fade show {{active}}" id="tabpa{{cont}}" role="tabpanel">
								<div id="carousel-hw-{{cont}}" class="owl-carousel owl-carousel-hw mt-5">
									{% for hw in item %}
										<div class="element position-relative">
											<img src="{{ file_url(hw.svg) }}">
											{% if hw.enlace|length > 0 %}
											<div class="btn-purchase button--aylen">
											<a target="_blank" href="{{hw.enlace|replace({'internal:':''})}}">
													{{hw.enlaceText}}
											</a>	
											</div>
											{% endif %}
										</div>
									{% endfor %}
								</div>
							</div>
							{% set cont = cont	+1%} 
						{% endfor %}
					</div>
				</div>
			</div>
		</div>
	{% endif %}
{% endapply %}
