<style type="text/css" media="screen">
	body {
		background-color: #CCC !important;
	}
</style>
{% apply spaceless %}
	{% if data|length > 0 %}
		<div class="container bg-white hw ">
			<div class="row">
				<div class="ml-4">
					<div class="page-title azulclaro">
						<h2>{{ 'Web Hosting'|t|upper }}</h2>
					</div>
				</div>
				<div class="offset-lg-3 offset-md-5 offset-sm-3 pl-md-5 pl-2">
					<div class="paquete-filtro">
						<label>
							{{ 'Select:'|t }}</label>
						<select name="combo" id="combo">
							<option value="todos">{{"All"|t}}</option>
							{% for item in data %}
								<option value="{{ item.tipo }}">{{ item.tipo }}</option>
							{% endfor %}
						</select>
					</div>
				</div>
			</div>
			{% for item in data %}
				<div id="seccion-{{item.tipo}}" class="row no-gutters px-1 justify-content-center {{item.tipo}} items mt-4">
					<div class="title col-12 ml-4">
						<h4>{{ item.tipo|upper }}</h4>
					</div>
					{% for hw in item.hws %}
						{% if loop.first %}
							<div class="subtitle col-12 ml-4">
								{% if hw.subtitulo %}
									<p>{{ hw.subtitulo }}</p>
								{% endif %}
							</div>
						{% endif %}
						<div class="col-12 col-sm-6 col-md-4 col-lg-3 prelative text-center mb-2">
							<div class="element prelative">
								<img src="{{ file_url(hw.svg) }}">
								{% if hw.enlace|length > 0 %}
									<div class="btn-purchase button--aylen">
										<a target="_blank" href="{{hw.enlace|replace({'internal:':''})}}">{{hw.enlaceText}}</a>
									</div>
								{% endif %}
							</div>
						</div>
					{% endfor %}
					{% if pregunta[item.tipo]|length > 0 %}
						<div id="accordion-{{item.tipo}}" class="faq accordion col-12 pb-3">
							<div class="card mt-3 mb-3">
								<div id="heading{{ item.tipo }}" class="card-header bg-white" data-toggle="collapse" data-target="#collapse{{ keys }}" aria-expanded="false" aria-controls="collapse{{ keys }}">
									<div class="position-relative collapsible-link word-break">
										<p>{{ 'Something you should know'|t }}</p>
									</div>
								</div>
								<div id="collapse{{item.tipo}}" aria-labelledby="heading{{item.tipo}}" data-parent="#accordion-{{keys}}" class="collapse">
									<div class="card-body p-2">
										<p class="font-weight-light m-0">{{pregunta[item.tipo]|raw}}</p>
									</div>
								</div>
							</div>
						</div>
					{% endif %}
				</div>
				<div class="line"></div>
			{% endfor %}
			<div class="preg-frecuentes mt-4 position-relative">
				<div style="display: inline-block;margin-bottom:1rem;"><span>{{'In case you have any question about our bundles, packages or plans, please visit:'|t}}</span></div>
				<div class="btn-purchase button--aylen">
					<a href="{{ path('etecsa.faqtodas',{'clientef': cliente }) }}">{{ 'Frequently Asked Questions'|t|upper}}</a>
				</div>
			</div>
		{% endif %}
	{% endapply %}
