{% apply spaceless %}
{% set content = data.0 %}
<div class="container bg-white">
  <div class="row">
    <div class="ml-4">
      <div class="page-title azuloscuro">
        <h2 class="upper">{{ content.title.value }}</h2>
      </div>
    </div>


    {% if content.field_tipo_imagen.value == 'grande' and content.field_imagen_grande.value|length > 0 %}
    {% set img = file_url(content.field_imagen_grande.entity.uri.value) %}
    {% elseif content.field_tipo_imagen.value == 'pequeña' and content.field_imagen_pequena.value|length > 0 %}
    {% set img = file_url(content.field_imagen_pequena.entity.uri.value) %}
    {% endif %}

    {% if img %}
    <div class="cmt">
      <img class="w-100" src="{{ img }}" alt="">
    </div>
    {% endif %}

    <div class="col-12 word-break px-5 pb-3 pt-4">{{ content.field_descripcion.value|raw }}</div>
    <div class="col-12 word-break px-5 pb-3 pt-4">{{ content.field_servicios.value|raw }}</div>
    <div class="col-11 container-form roaming mb-3 mx-md-5 mx-lg-5 mx-2">
      {{form}}
    </div>
	
    <hr style="border: 2px solid #0099cc; margin: 1rem 0; width: 100%;" />

    <div class="col-12 word-break px-5 pb-3 pt-4 certificate-container">
    </div>

    <div class="col-12 word-break px-5 pb-3 pt-4 certificate-paginator">
      
    </div>


    <div class="col-12 word-break pl-md-5 pl-sm-1 pb-3 pt-4">
      <h4 style="color: #000066;">{{ 'Documents to consult'|t }}</h4>
      <hr style="border-top: 2px solid rgb(0,0, 0,.25);" />

      {% for file in content.field_doc_relacionados %}
      {% set name = file.entity.filename.value %}
      <div class="file-container"><a target="_blank"
          href="{{ file_url(file.entity.uri.value) }}">
          <img src="{{ icon_generic }}" alt="" />
          <span class="color-celeste ml-4"> {{ name }}</span></a></div>
      {% endfor %}
    </div>

    <div class="col-12 word-break pl-md-5 pl-sm-1 pb-3 pt-4">
      <h4 style="color: #000066;">{{ 'Download'|t }}</h4>
      <hr style="border-top: 2px solid rgb(0,0, 0,.25);" />
      {% for file in content.field_fichero_s_ %}
      {% set name = file.entity.filename.value %}
      <div class="file-container"><a target="_blank"
          href="{{ file_url(file.entity.uri.value) }}">
          <img src="{{ icon_generic }}" alt="" />
          <span class="color-celeste ml-4"> {{ name }}</span></a></div>
      {% endfor %}

    </div>

    <div class="col-12 word-break pl-md-5 pl-sm-1 pb-3 pt-4">{{ content.field_contacto_atencion.value|raw }}</div>
    {% if content.field_faq|length > 0 %}
    <div class="col-12 word-break pl-5 pb-3 pt-4">
      <div class="btn-purchase button--aylen" style="width: auto;">
        <a href="{{ path('etecsa.faq', {'faq': content.nid.value }) }}">{{ 'Frequently Asked Questions'|t|upper}}
        </a>
      </div>
    </div>
    {% endif %}
  </div>
  {% endapply %}