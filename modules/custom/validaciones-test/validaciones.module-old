    }

    if ($form_id == 'taxonomy_overview_vocabularies') {
      // Add a cancel button.
      $form['actions']['cancel'] = [
        '#type' => 'submit',
        '#value' => t('Cancel'),
        '#access' => TRUE,
        '#weight' => 15,
        '#attributes' => ['onclick' => 'if(!confirm("¿Está seguro que desea cancelar?")){return false;}'],
        '#submit' => ['seven_taxformes_cancel'],
        '#limit_validation_errors' => [],
      ];
    }

    if (strpos($form_id, 'taxonomy_term_') !== FALSE) {
      // Add a cancel button.
      $form['actions']['cancel'] = [
        '#type' => 'submit',
        '#value' => t('Cancel'),
        '#access' => TRUE,
        '#weight' => 15,
        '#attributes' => ['onclick' => 'if(!confirm("¿Está seguro que desea cancelar?")){return false;}'],
        '#submit' => ['seven_taxform_cancel'],
        '#limit_validation_errors' => [],
      ];
    }

    if ($form_id == 'comment_comment_delete_form') {
      // Add a cancel button.
      $form['actions']['cancel'] = [
        '#type' => 'submit',
        '#value' => t('Cancel'),
        '#access' => TRUE,
        '#weight' => 15,
        '#attributes' => ['onclick' => 'if(!confirm("¿Está seguro que desea cancelar?")){return false;}'],
        '#submit' => ['seven_comment_delete_form_cancel'],
        '#limit_validation_errors' => [],
      ];
    }

    if ($form_id == 'comment_comment_form' && \Drupal::currentUser()->isAuthenticated()) {
      // Add a cancel button.
      $form['actions']['cancelcomment'] = [
        '#type' => 'submit',
        '#value' => t('Cancel'),
        '#access' => TRUE,
        '#weight' => 15,
        '#attributes' => ['onclick' => 'if(!confirm("¿Está seguro que desea cancelar?")){return false;}'],
        '#submit' => ['seven_comment_form_cancel'],
        '#limit_validation_errors' => [],
      ];

    if ($form_id == 'user_form' || $form_id == 'user_register_form') {
      // Add a cancel button.
      $form['actions']['cancel'] = [
        '#type' => 'submit',
        '#value' => t('Cancel'),
        '#access' => TRUE,
        '#weight' => 15,
        '#attributes' => ['onclick' => 'if(!confirm("¿Está seguro que desea cancelar?")){return false;}'],
        '#submit' => ['seven_user_form_cancel'],
        '#limit_validation_errors' => [],
