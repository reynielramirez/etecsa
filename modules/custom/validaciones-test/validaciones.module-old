}
function validaciones_node_form_submit(&$form, $form_state) {
  $form_state->setRedirect('system.admin_content');
}
function validaciones_form_cancel(&$form, $form_state) {
  return $form_state->setRedirect('system.admin_content');
}

function seven_user_form_cancel(&$form, $form_state) {
  return $form_state->setRedirect('entity.user.collection');
}

function seven_taxformes_cancel(&$form, $form_state) {
  return $form_state->setRedirect('system.admin_structure');

}

function seven_taxform_cancel(&$form, $form_state) {
  return $form_state->setRedirect('entity.taxonomy_vocabulary.collection');

}

function seven_comment_delete_form_cancel(&$form, $form_state) {
  return $form_state->setRedirect('comment.admin');
}

function seven_comment_form_cancel(&$form, $form_state) {
  return $form_state->setRedirect('comment.admin');
}


function cant_nodes_validate($form, $form_state) {
    $val=new ValidacionesController();
    $node = $form_state->getFormObject()->getEntity();      
    $nid=$node->nid->value;
    $cliente=$form_state->getValue('field_tipo_de_clientes');
    if(!empty($cliente[0]['target_id'])){
      $countCart=$val->Cant_cartFlotantes($nid,$cliente[0]['target_id']);
     
      if($countCart>=4){     
        $form_state->setErrorByName('field_tipo_de_clientes',t('Solo se admiten 4 carts flotantes para el tipo de cliente seleccionado.'));
      }
    }
    
}   
function correo_validate($form, $form_state) {
  $val=new ValidacionesController();
  $correo=$form_state->getValue('field_correodt');   
  if(!empty($correo[0]['value'])){
    $validC=$val->ValidarCorreo($correo[0]['value']);
    if (!$validC) {
      $form_state->setErrorByName("field_correodt", t('El campo Correo electrónico debe tener el formato: usuario@dominioddd. '));
  }
  }
  
}  
function campo_unico_validate($form, $form_state) {
  $val=new ValidacionesController();
  $node = $form_state->getFormObject()->getEntity();
  $typeName = $node->getType();
  $nid=$node->nid->value; 
  $campo="title";
  $nombre = $form_state->getValue('title');
  $valor=$nombre[0]['value'];
  $fieldName = $node->title->getFieldDefinition()->getLabel();

  if($typeName=="preguntas_frecuentes"){
      $tema = $form_state->getValue('field_tema');
      $valor=$tema[0]['target_id'];
      $campo = "field_tema";
      $fieldName = $node->field_tema->getFieldDefinition()->getLabel();
      $cliente = $form_state->getValue('field_tipo_de_clientes');
      $cliente=$cliente[0]['target_id'];
      
      $count=$val->CampoUnico($typeName,$campo,$valor,$nid,$cliente,null); 
      
  }
  elseif($typeName=="oportunidad"){
    $oportunidad = $form_state->getValue('field_tipo_servoportunidades');
    $oportunidad=$oportunidad[0]['value'];
    $cliente = $form_state->getValue('field_tipo_de_clientes');
    $cliente=$cliente[0]['target_id'];
    $count=$val->CampoUnico($typeName,$campo,$valor,$nid,$cliente,$oportunidad); 
    
}
  elseif($typeName=="noticia"||$typeName=="cart_flotante"||$typeName=="promocion_corta"||$typeName=="solucion"){
      $cliente = $form_state->getValue('field_tipo_de_clientes');
      $cliente=$cliente[0]['target_id'];
      $count=$val->CampoUnico($typeName,$campo,$valor,$nid,$cliente,null);
  }
  else{
    $count=$val->CampoUnico($typeName,$campo,$valor,$nid,null,null);
  }
   
    if ($count>0) {
      $form_state->setErrorByName($campo, t('El campo '. $fieldName.' es único, el valor especificado ya se encuentra  en uso.'));
    }
 
}   
function fecha_validate(&$form, $form_state) {
  $fecha_fin=$form_state->getValue('field_fecha_fin')[0]['value'];
  $fecha_inicio=$form_state->getValue('field_fechainicio')[0]['value'];
  if ($fecha_fin < $fecha_inicio) {
    $form_state->setErrorByName('field_fecha_fin_de_la_promocion', t('La fecha fin de la Promoción debe ser igual o mayor que su fecha de inicio.'));
  }
}  

function validaciones_file_validate($file) {
  $size= $file->getSize();
  $errors = array();
  if($file){
    if($size<=0){
      $errors[] = t("El tamaño del archivo debe ser mayor que 0 byte.");
    }
  }
  return $errors;
}

function validaciones_cron()
{
    $fecha_actual=date("Y-m-d");
  
    $nids = \Drupal::entityQuery("node")
    ->condition('type', 'noticia')
    ->condition('field_promo', 1)
    ->condition('field_fecha_fin_de_la_promocion', $fecha_actual,"<")
    ->execute();   
    $storage_handler = \Drupal::entityTypeManager()->getStorage("node");
    $nodes = \Drupal\node\Entity\Node::loadMultiple($nids);

    $nidsO = \Drupal::entityQuery("node")
    ->condition('type', 'oportunidad')
    ->condition('field_tipo_servoportunidades', 'oportunidad')
    ->condition('field_fecha_fin_de_la_promocion', $fecha_actual,"<")
    ->execute();   
    $nodes+=\Drupal\node\Entity\Node::loadMultiple($nidsO);

    foreach ($nodes as $node)
    {       
      $node->setPublished(false);
      $node->set('moderation_state', "archivado");
      $node->save();
     
    }
    
    
}


