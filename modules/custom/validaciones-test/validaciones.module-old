  }
  if ( $form_id=="node_noticia_form"||$form_id=="node_noticia_edit_form"||$form_id=="node_noticia_quick_node_clone_form") {
    $form['field_noticia_resumen']['widget']['0']['value']['#maxlength'] = 200;
  }
  if ($form_id == "node_proteccion_al_consumidor_home_form" || $form_id == "node_proteccion_al_consumidor_home_edit_form" || $form_id == "node_proteccion_al_consumidor_home_quick_node_clone_form"||
      $form_id=="node_info_gen_nues_sedes_form" || $form_id=="node_info_gen_nues_sedes_edit_form" || $form_id=="node_info_gen_nues_sedes_quick_node_clone_form" ||
      $form_id=="node_red_comercial_form" ||$form_id=="node_red_comercial_edit_form" || $form_id=="node_red_comercial_quick_node_clone_form"||
      $form_id=="node_revista_tono_pd_form" || $form_id=="node_revista_tono_pd_edit_form" || $form_id=="node_revista_tono_pd_quick_node_clone_form"||
      $form_id=="node_establecimiento_edit_form"||$form_id=="node_page_form"||$form_id=="node_page_edit_form"|| $form_id=="node_page_quick_node_clone_form"||
      $form_id=="node_operador_roaming_form"||$form_id=="node_operador_roaming_edit_form" ||$form_id=="node_operador_roaming_quick_node_clone_form"|| 
      $form_id=="node_promocion_corta_form"||$form_id=="node_promocion_corta_edit_form"||$form_id=="node_promocion_corta_quick_node_clone_form"||
      $form_id=="node_noticia_form"||$form_id=="node_noticia_edit_form"||$form_id=="node_noticia_quick_node_clone_form"||
      $form_id=="node_aplicacion_form"||$form_id=="node_aplicacion_edit_form"||$form_id=="node_aplicacion_quick_node_clone_form"||
      $form_id=="node_consejos_utiles_form"||$form_id=="node_consejos_utiles_edit_form"||$form_id=="node_consejos_utiles_quick_node_clone_form"||
      $form_id=="node_proteccion_al_consumidor_form"||$form_id=="node_proteccion_al_consumidor_edit_form"||$form_id=="node_proteccion_al_consumidor_quick_node_clone_form"||
      $form_id=="node_prot_cons_contactos_form"||$form_id=="node_prot_cons_contactos_edit_form"||$form_id=="node_prot_cons_contactos_quick_node_clone_form"||
      $form_id=="node_descripcion_general_de_espacios__form"||$form_id=="node_descripcion_general_de_espacios__edit_form"||$form_id=="node_descripcion_general_de_espacios__quick_node_clone_form"||
      $form_id=="node_espacios_publicos_form"||$form_id=="node_espacios_publicos_edit_form"||$form_id=="node_espacios_publicos_quick_node_clone_form"||
      $form_id=="node_sobre_de_nosotros_form"||$form_id=="node_sobre_de_nosotros_edit_form"||$form_id=="node_sobre_de_nosotros_quick_node_clone_form" ||
      $form_id=="node_sede_form"||$form_id=="node_sede_edit_form"||$form_id=="node_sede_quick_node_clone_form"||
      $form_id=="node_divisiones_territoriales_form"||$form_id=="node_divisiones_territoriales_edit_form"||$form_id=="node_divisiones_territoriales_quick_node_clone_form"){

