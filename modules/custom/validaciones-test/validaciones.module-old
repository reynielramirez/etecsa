    $form_id=="node_enlace_auxiliar_edit_form"||$form_id=="node_enlace_auxiliar_quick_node_clone_form"||$form_id=="node_revista_tono_pd_form"||
    $form_id=="node_revista_tono_pd_edit_form"||$form_id=="node_revista_tono_pd_quick_node_clone_form"||$form_id=="node_servicio_de_atencion_telefonica_form"||$form_id=="node_servicio_de_atencion_telefonica_quick_node_clone_form"||
    $form_id=="node_servicio_de_atencion_telefonica_edit_form"||$form_id=="node_cart_flotante_quick_node_clone_form"
    ||$form_id=="node_cart_flotante_form"||$form_id=="node_cart_flotante_edit_form"||$form_id=="node_equipo_quick_node_clone_form"
    ||$form_id=="node_equipo_form"||$form_id=="node_equipo_edit_form"||/*$form_id=="node_preguntas_frecuentes_quick_node_clone_form"
    ||$form_id=="node_preguntas_frecuentes_form"||$form_id=="node_preguntas_frecuentes_edit_form"||*/$form_id=="node_solucion_quick_node_clone_form"
    ||$form_id=="node_solucion_form"||$form_id=="node_solucion_edit_form"||$form_id=="node_oportunidad_quick_node_clone_form"
    ||$form_id=="node_oportunidad_form"||$form_id=="node_oportunidad_edit_form") {
