    $form['field_segundo_apellido']['widget']['0']['value']['#placeholder'] = t('Allow 50 characters');
    $form['field_direccion_postal_qr']['widget']['0']['value']['#placeholder'] = t('Allow 120 characters');
    $form['field_correo_electronico_qr']['widget']['0']['value']['#placeholder'] = t('user@domain');
    $form['field_correo_electronico_qr']['#attributes']['autocomplete'] = 'off';
    $form['field_servicio_telefonico_de_loc']['widget']['0']['value']['#placeholder'] = t('Allow 15 characters');
    $form['field_servicio_afectado']['widget']['0']['value']['#placeholder'] = t('Allow 120 characters');
