<?php

/**
 * @file
 * Functions to support theming in the SASS Starterkit subtheme.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Field\FieldItemList;
use Drupal\file\Entity\File;

/**
 * Implements hook_form_system_theme_settings_alter() for settings form.
 *
 * Replace Barrio setting options with subtheme ones.
 *
 * Example on how to alter theme settings form
 */
function etecsa_subtheme_form_system_theme_settings_alter(&$form, FormStateInterface $form_state) {
  $form['components']['navbar']['bootstrap_barrio_navbar_top_background']['#options'] = [
    'bg-primary' => t('Primary'),
    'bg-secondary' => t('Secondary'),
    'bg-light' => t('Light'),
    'bg-dark' => t('Dark'),
    'bg-white' => t('White'),
    'bg-transparent' => t('Transparent'),
  ];
  $form['components']['navbar']['bootstrap_barrio_navbar_background']['#options'] = [
    'bg-primary' => t('Primary'),
    'bg-secondary' => t('Secondary'),
    'bg-light' => t('Light'),
    'bg-dark' => t('Dark'),
    'bg-white' => t('White'),
    'bg-transparent' => t('Transparent'),
  ];
}
function etecsa_subtheme_preprocess(&$variables) {
  $baseurl=$GLOBALS['base_url'];
  $language=\Drupal::languageManager()->getCurrentLanguage()->getId();
  $variables['language']=$language;
  $variables['base_path']=base_path();
  $base_url_parts = parse_url($baseurl);  
  $variables['host'] = $base_url_parts['host'];
}

function etecsa_subtheme_page_attachments_alter(array &$page) {
  if (empty($page['#attached']['html_head'])) {
    return;
  }
  foreach ($page['#attached']['html_head'] as $id => $tag) {
    if (isset($tag[1]) && $tag[1] == 'system_meta_generator') {
      unset($page['#attached']['html_head'][$id]);
    }
  }
}

/**
 * Attach file type icon URLs for node templates.
 */
function etecsa_subtheme_attach_file_icons(array &$variables): void {
  $variables['icon_doc'] = NULL;
  $variables['icon_xls'] = NULL;
  $variables['icon_pdf'] = NULL;
  $variables['icon_rar'] = NULL;
  $variables['icon_generic'] = NULL;

  $icons = \Drupal::config('etecsa_module.etecsasettings')->get('icons') ?? [];
  if (!is_array($icons)) {
    return;
  }

  $url_generator = \Drupal::service('file_url_generator');
  $map = [
    'doc' => 'icon_doc',
    'xls' => 'icon_xls',
    'pdf' => 'icon_pdf',
    'rar' => 'icon_rar',
    'generic' => 'icon_generic',
  ];
  foreach ($map as $key => $variable_name) {
    if (empty($icons[$key]) || !is_array($icons[$key])) {
      continue;
    }
    $fid = reset($icons[$key]);
    if (!$fid) {
      continue;
    }
    $file = File::load($fid);
    if ($file) {
      $variables[$variable_name] = $url_generator->generateString($file->getFileUri());
    }
  }
}

function etecsa_subtheme_preprocess_node(&$variables)
{
    if ($variables['node']->getType() == 'equipo'){
      $nid = $variables['node']->nid->value;
      $node = \Drupal\node\Entity\Node::load($nid);

      if (!empty($node)){
        $equiposRecomendados = [];
        $etecsaService = \Drupal::service('etecsa.etecsa_service');
        foreach ($node->get('field_equipos_de_recomendados') as $key => $value) {
          $id = $value->target_id;
          $node = \Drupal\node\Entity\Node::load($id);
          if (!empty($node)){
            $marca = $etecsaService->getTaxTermById($node->get('field_marca')->target_id);
            $modelo = $etecsaService->getTaxTermById($node->get('field_modelo')->target_id);
            $equipo = [
              'nuevo' => $node->get('field_nuevo')->value,
              'precio' => $node->get('field_precio')->value,
              'moneda' => $node->get('field_moneda')->value,
              'nid' => $id,
              'marca' => $marca->getName(),
              'modelo' => $modelo->getName(),
              'imagen' => $node->get('field_image')->entity->uri->value,
            ];
         
          $equiposRecomendados['eq'][] = $equipo;
        }
        }
        $pages = (count($equiposRecomendados) % 4 != 0) ? intdiv(count($equiposRecomendados), 4) + 1 : intdiv(count($equiposRecomendados), 4);
        $equiposRecomendados['pages'] = $pages;
        $variables['equiposRecomendados'] = $equiposRecomendados;
      }
    }

    if($variables['node']->getType()=="aplicacion"){
      $node=$variables['node'];
      $file = $node->get('field_fichero')->entity;
      $sizeTemp=$file->getSize();
      $etecsaService = \Drupal::service('etecsa.etecsa_service');
      $size = $etecsaService->formatBytes($sizeTemp);  
      $variables["size"] =$size; 
    }
    
    if($variables['node']->getType()=="oportunidad"){
      $nid = $variables['node']->nid->value;     
      $alias = \Drupal::service('path_alias.manager')->getAliasByPath('/node/'.$nid);
      $tipo_cliente = explode("/",$alias);
      $language = \Drupal::languageManager()->getCurrentLanguage()->getId();

   
      $vocabularyCliente = 'tipos_de_clientes';
      $segment = $tipo_cliente[1] ?? 'inicio';
      $etecsaService = \Drupal::service('etecsa.etecsa_service');
      $text = $language == "es" ? "servicios-oportunidades" : "services-opportunities";
      if ($segment === 'inicio' || $segment === $text) {
        $name = "Personas";
      }
      else {
        $name = ucfirst($segment);
      }
      $termClienteId = $etecsaService->getIdbyName($name, $vocabularyCliente);

      $queryOport = \Drupal::entityQuery('node')->accessCheck(FALSE)->condition('type', 'oportunidad')
        ->condition('field_tipo_de_clientes', $termClienteId)
        ->condition('field_tipo_servoportunidades', 'oportunidad') 
        ->condition('langcode', $language)   
        ->condition('status',1)
        ->execute();
          
      $queryServ = \Drupal::entityQuery('node')->accessCheck(FALSE)->condition('type', 'oportunidad')
        ->condition('field_tipo_de_clientes', $termClienteId)
        ->condition('field_tipo_servoportunidades', 'servicio') 
        ->condition('langcode', $language)   
        ->condition('status',1)
        ->execute();   
        
        $variables["countOport"] =count($queryOport);  
        $variables["countServ"] =count($queryServ);
        $variables["clienteId"]=$termClienteId;
    }

    if ($variables['node']->getType() == 'plaza') {
      etecsa_subtheme_attach_file_icons($variables);
    }
}

function etecsa_subtheme_preprocess_page(&$variables) {
  $baseurl=$GLOBALS['base_url'];
  $current_path = \Drupal::service('path.current')->getPath();
  $language = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $variables['#attached']['drupalSettings']['url'] = \Drupal::service('path_alias.manager')->getAliasByPath($current_path);
  $variables['#attached']['drupalSettings']['urlfaq'] = \Drupal::request()->getRequestUri();
  $variables['#attached']['drupalSettings']['language'] = $language;
  $base_url_parts = parse_url($baseurl);  
  $variables['#attached']['drupalSettings']['host'] = $base_url_parts['host'];
}
