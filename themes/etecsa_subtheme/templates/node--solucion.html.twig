{% apply spaceless %}
{% if node.field_oport_rec[0]|length > 0 %}
    {% set margin="mb-3" %}
{% else%}
    {% set margin="mb-5" %}    
{% endif %}
<div class="container bg-white {{margin}}">
    <div class="row">
        <div class="ml-4">
            <div class="page-title nodeso azulclaro">
                <h2>{{'Technological Solutions'|t|upper}}</h2>
            </div>
        </div>
        <div class="cmt">  
            {% if node.field_tipo_de_imagen.value == 'grande' and node.field_imagen_grande|length > 0 %}
                <img  class="w-100" src="{{ file_url(node.field_imagen_grande.entity.fileuri) }}" alt="">
            {% elseif node.field_tipo_de_imagen.value == 'pequeña' and node.field_imagen_pequena|length > 0 %}  	
                <img  class="w-100" src="{{ file_url(node.field_imagen_pequena.entity.fileuri) }}" alt="">
            {% endif %} 
        </div>
        <div class="oportunidad mb-5">
            <div class="title px-3 pl-md-5 pl-lg-5 mb-2 mt-4">
                <h4 class="pl-md-5 pl-lg-5">{{ label}} {{ content.field_subtitulo[0] }}</h4>
            </div>
			<div class="title px-3 pl-md-5 pl-lg-5 mb-2 mt-4">
                <h4 class="pl-md-5 pl-lg-5">{{ content.field_soluc_tec_tipo[0] }}</h4>
            </div>
            <div class="col-12 px-3 px-md-5 px-lg-5">                
                <div class="word-break pl-md-5 pl-lg-5 ">{{ content.field_descripcion[0]|raw }}</div>
            </div>
        </div>
    </div>
    {% if node.field_faq[0]|length > 0 %}
    <div class="row justify-content-center cborder-top">
        <div class="row faq oportunidad pb-5 pt-5">
            <div class="texto">
                <p style="display: inline-block;margin-bottom:1rem;">{{ 'May Check:'|t }} </p>
            </div>
            <div class="btn-purchase button--aylen">
                    <a href="{{ path('etecsa.faq', {'faq': node.nid.value }) }}">{{ 'Frequently Asked Questions'|t|upper}} </a>
				</div>            
        </div>
    </div>
    {% endif %}
</div>
{% if node.field_oport_rec[0]|length > 0 %}
    <div class="container bg-white mb-5 pb-5">
        <h4 class="titulopor pt-3 pb-3">{{'We recommend other opportunities'|t}}</h4>
        <div id="carousel-oportnode" class="owl-carousel owl-theme">
            {% for item in node.field_oport_rec %} {% set resumen = item.entity.field_descripcion.value|render|striptags|trim %}
            <a href="{{ path('entity.node.canonical', {'node': item.entity.nid.value }) }}">
                <div class="servoport-item">
                    <div class="servoport-img-item">
                        <img src="{{ file_url(item.entity.field_image.entity.fileuri) }}" alt="{{ item.entity.field_image.entity.alt}}" />
                    </div>
                    <div class="text">
                        <h4 class="servoport-title node-title-servoport">{{item.entity.field_titulo.value}}</h4>
                        <h5 class="servoport-subtitle pt-2">{{ item.entity.field_subtitulo.value}}</h5>
                        <div class="servoport-resumen  pl-4 pr-4 word-break">{{ (resumen|length >150 ? resumen|slice(0, 151)|split(' ')|slice(0, -1)|join(' ') ~ '&hellip; ' : resumen)|raw }}</div>
                    </div>
                </div>
            </a>
            {% endfor %}
        </div>
    </div>
{% endif %}
{% endapply %} 
{{ attach_library('etecsa_module/servoportall-styling') }}
